<Window x:Class="FleetManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FleetManager.Views"
        Title="FleetManager - Céges flottakezelő"
        Height="750"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">

    <Window.Resources>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D7E2EF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#344B68"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#15253B"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SearchStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#15253B">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="FleetManager"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="25,0,0,0"/>

            <TextBlock Grid.Column="1"
                       Text="Céges flottakezelő rendszer"
                       FontSize="14"
                       Foreground="#B8C8DD"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,30,0"/>

        </Grid>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Background="#23364F">

                <TextBlock Text="NAVIGÁCIÓ"
                           Foreground="#90A5BE"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="20,30,0,15"/>

                <Button x:Name="btnAttekintes"
                        Content="Áttekintés"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button x:Name="btnGepjarmuvekMenu"
                        Content="Gépjárművek"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button x:Name="btnMunkavallalokMenu"
                        Content="Munkavállalók"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button x:Name="btnSzervizelesekMenu"
                        Content="Szervizelések"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="Kilométeróra-állások"
                        Style="{StaticResource MenuButtonStyle}"/>

            </StackPanel>

            <Grid Grid.Column="1">

                <Grid x:Name="pnlAttekintes"
                      Margin="30">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Flottaáttekintés"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#15253B"
                               Margin="0,0,0,25"/>

                    <UniformGrid Grid.Row="1"
                                 Columns="4"
                                 Margin="0,0,-15,0">

                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Összes gépjármű"
                                           Foreground="#718096"
                                           FontSize="13"/>

                                <TextBlock x:Name="txtOsszesGepjarmu"
                                           Text="0"
                                           Style="{StaticResource StatNumberStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Aktív járművek"
                                           Foreground="#718096"
                                           FontSize="13"/>

                                <TextBlock x:Name="txtAktivGepjarmu"
                                           Text="0"
                                           Style="{StaticResource StatNumberStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Szervizben"
                                           Foreground="#718096"
                                           FontSize="13"/>

                                <TextBlock x:Name="txtSzervizben"
                                           Text="0"
                                           Style="{StaticResource StatNumberStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Lejáró műszakik"
                                           Foreground="#718096"
                                           FontSize="13"/>

                                <TextBlock x:Name="txtLejaroMuszaki"
                                           Text="0"
                                           Style="{StaticResource StatNumberStyle}"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <Border Grid.Row="2"
                            Background="White"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,25,0,0">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,15">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Gépjárművek listája"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#15253B"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">

                                    <Button x:Name="btnGepjarmuTorles"
                                            Content="Törlés"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#DC2626"
                                            Margin="0,0,10,0"/>

                                    <Button x:Name="btnGepjarmuSzerkesztes"
                                            Content="Szerkesztés"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#64748B"
                                            Margin="0,0,10,0"/>

                                    <Button x:Name="btnUjGepjarmu"
                                            Content="+ Új gépjármű"
                                            Style="{StaticResource PrimaryButtonStyle}"/>

                                </StackPanel>

                            </Grid>

                            <TextBox Grid.Row="1"
                                     x:Name="txtGepjarmuKereses"
                                     Style="{StaticResource SearchStyle}"
                                     Margin="0,0,0,15"
                                     ToolTip="Keresés rendszám, márka, modell, évjárat vagy állapot alapján"/>

                            <DataGrid Grid.Row="2"
                                      x:Name="dgGepjarmuvek"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      HorizontalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Rendszám"
                                                        Binding="{Binding Rendszam}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Márka"
                                                        Binding="{Binding Marka}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Modell"
                                                        Binding="{Binding Modell}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Évjárat"
                                                        Binding="{Binding Evjarat}"
                                                        Width="80"/>

                                    <DataGridTextColumn Header="Állapot"
                                                        Binding="{Binding Allapot}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Hozzárendelt munkavállaló"
                                                        Binding="{Binding Munkavallalo.Nev}"
                                                        Width="200"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Border>

                </Grid>

                <views:MunkavallalokView x:Name="munkavallalokView"
                                         Visibility="Collapsed"/>

                <views:SzervizelesekView x:Name="szervizelesekView"
                                         Visibility="Collapsed"/>

            </Grid>

        </Grid>

    </Grid>

</Window>