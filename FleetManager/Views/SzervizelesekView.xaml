<UserControl x:Class="FleetManager.Views.SzervizelesekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA">

    <UserControl.Resources>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SearchStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Szervizelések"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#15253B"
                   Margin="0,0,0,25"/>

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">

                <TextBlock Text="Keresés a szervizelések között"
                           FontSize="12"
                           Foreground="#718096"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtSzervizKereses"
                         Style="{StaticResource SearchStyle}"
                         ToolTip="Keresés rendszám, szerviztípus vagy leírás alapján"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">

                <Button x:Name="btnSzervizTorles"
                        Content="Törlés"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#DC2626"
                        Margin="0,0,10,0"/>

                <Button x:Name="btnSzervizSzerkesztes"
                        Content="Szerkesztés"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#64748B"
                        Margin="0,0,10,0"/>

                <Button x:Name="btnUjSzerviz"
                        Content="+ Új szervizelés"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2563EB"/>

            </StackPanel>

        </Grid>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Szervizelési előzmények"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#15253B"
                           Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1"
                          x:Name="dgSzervizelesek"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Rendszám"
                                            Binding="{Binding Gepjarmu.Rendszam}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Szerviz dátuma"
                                            Binding="{Binding SzervizDatum, StringFormat={}{0:yyyy.MM.dd}}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Szerviz típusa"
                                            Binding="{Binding SzervizTipus}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Leírás"
                                            Binding="{Binding Leiras}"
                                            Width="230"/>

                        <DataGridTextColumn Header="Költség (Ft)"
                                            Binding="{Binding Koltseg, StringFormat={}{0:N0}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Kilométeróra"
                                            Binding="{Binding Kilometerora}"
                                            Width="110"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>